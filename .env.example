# Alfa: e so isto. Estas linhas chegam para copiar para `.env` e arrancar o sigma.
# O resto do ficheiro e laboratorio — e o porteiro (H4) recusa arrancar live com elas a mandar.

POLICY=sigma
HL_COINS=BTC
HL_TESTNET=true
DRY_RUN=true
LEVERAGE=1
BANKROLL_USD=200
LEDGER_DIR=./data/ledger
TICK_MS=2000
BOOK_STALE_MS=5000
PORT=3000
# Circuit breaker de chop: viradas na janela que armam a caixa, a janela e a caixa.
# O default vive no codigo (4 viradas / 12 h / 6 h, em src/config.ts) e nao precisa de estar aqui.
# Descomentar sobrepoe-se ao codigo, e a bootLine passa a dizer a origem de cada um:
# cbFlips=4 (env) contra cbFlips=4 (config). Fora da banda (0, negativo, mais viradas do que
# horas na janela) o motor nao arranca. So se toca com razao escrita.
#CB_FLIPS=4
#CB_WINDOW_H=12
#CB_CAIXA_H=6
# Vazio = sem ordem real: livro real, decisoes reais, fills simulados.
PRIVATE_KEY=

# --- Laboratorio. Nada daqui e preciso para arrancar o sigma. ---
# O numero em cada linha e o default do codigo em src/config.ts; mexer aqui muda so o laboratorio.
# MODEL=mock
# POLICY=jev
# POLICY_FILE=./policy/jev_questions.json
# JEV_PROVIDER=typesafe
# TYPESAFE_API_KEY=
# JEV_MODEL_ID=
# AI_GATEWAY_API_KEY=
# JEV_TIMEOUT_MS=800
# JEV_CONF_ACT=0.80
# NOUL_HOSTILE_TH=0.65
# STATE_MAX_WORDS=12
# OUTCOME_HORIZON_SECS=900
# PRICE_MS=200
# QUOTE_USD=40
# QUOTE_INSIDE_TICKS=1  (o sigma passa 0 = touch por codigo; esta var e o default dos outros caminhos)
# CLOSE_SLIPPAGE_BPS=5
# HORIZON_BLOCKS=100
# WALLETS_JSON={"sleeves":[{"coin":"ETH","privateKey":"0x..."}]}

