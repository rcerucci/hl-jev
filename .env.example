# Comma list of Hyperliquid perps.
HL_COINS=BTC,ETH,SOL,DOGE,BNB
# true = testnet (default). Set false only for mainnet.
HL_TESTNET=true
# Decision + requote cadence. Jev picks leverage, open/close/hold, and long/short.
TICK_MS=2000
# Chart and mid prints. Does not call Jev.
PRICE_MS=200
# Quote notional per tick. No sleeve or position cap.
QUOTE_USD=40
QUOTE_INSIDE_TICKS=1
# How far an exit crosses the touch. Closes are Ioc takers, not resting quotes.
CLOSE_SLIPPAGE_BPS=5
BANKROLL_USD=200
HORIZON_BLOCKS=100

# Live testnet: set PRIVATE_KEY for the first coin (BTC).
# Other coins: copy .wallets.example.json to .wallets.json (gitignored),
# or set WALLETS_JSON={"sleeves":[{"coin":"ETH","privateKey":"0x..."}]}
# Leave PRIVATE_KEY empty for a dry run: real book, real decisions, simulated fills.
# DRY_RUN=true forces simulated quotes even when keys are set.
PRIVATE_KEY=
DRY_RUN=false

# mock (default) | jev
MODEL=mock
# How Jev is called when MODEL=jev.
# typesafe = official TypeSafe API (https://docs.typesafe.ai/)
# gateway  = Vercel AI Gateway
# Unset: TypeSafe if TYPESAFE_API_KEY is set, else Gateway if AI_GATEWAY_API_KEY is set.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
# Model id. Defaults: jev-latest (typesafe), typesafe-ai/jev (gateway)
JEV_MODEL_ID=
# Gateway option. Set JEV_PROVIDER=gateway and fill this instead.
AI_GATEWAY_API_KEY=

# Bot SSE on 3000. Dashboard Next in web/ uses 3001.
PORT=3000

# --- Fusion policy path. Empty POLICY = the legacy path, where MODEL decides. ---
#
# sigma = THE ENGINE OF THE 100 ACCOUNT. H1 clock; one state s = sign(hl2 - EMA24) of the
#         already closed H1 candle (EMA from the previous bar, no lookahead); wick veto (a
#         turn only the wick crossed is ignored); chop breaker (3 turns in 12h -> 6h of
#         caixa, then the standing s applies). Touch-then-market, 1x, BTC, re-sized at the
#         episode close. Lands in slices: until it resolves, this mode is NOT runnable and
#         nothing here trades that account. Uncomment only when the slice says it is green.
# POLICY=sigma
#
# --- Laboratory modes: no edge claimed, no recipe, NOT the account path. ---
# jev     = live Jev through policy/jev_questions.json (needs the key above)
# dumb    = the control: a dumb heuristic over the same twelve words, no network
# numeric = sign(last20) control, ensaio N1 (closed: insuficiente)
# stance  = museum: buy/sell/hold/caixa over s and the L=130 channel u. The channel u was
#           measured on the real book and eats trend; kept only while the sigma CI is not
#           green. Do not present it as a live inventory.
POLICY=
POLICY_FILE=./policy/jev_questions.json
LEDGER_DIR=./data/ledger
# Hot path limits. A failure is a hold, never a guessed side.
JEV_TIMEOUT_MS=800
JEV_CONF_ACT=0.80
NOUL_HOSTILE_TH=0.65
STATE_MAX_WORDS=12
OUTCOME_HORIZON_SECS=900
# Leverage on the fused path is code, never a model answer (isolated per sleeve).
LEVERAGE=1
# A book older than this freezes the tick instead of deciding on stale prices.
BOOK_STALE_MS=5000

# --- Night editor (Fase D). TOMBSTONE, 25 Sep 2026: discarded, do not implement. ---
# Nothing reads these and nothing will; kept only so an old .env does not look current.
# It rewrites the criteria text of policy/jev_questions.json and proposes; it
# never publishes. The accept step stays manual.
# DeepSeek, OpenAI-compatible API. Sent with reasoning_effort=high and
# thinking enabled (DeepSeek request parameters).
NIGHT_BASE_URL=https://api.deepseek.com
NIGHT_MODEL=deepseek-flash
NIGHT_API_KEY=
NIGHT_REASONING_EFFORT=high
NIGHT_CRON=01:00
PROPOSAL_DIR=./proposals
