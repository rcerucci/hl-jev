# Alfa. Copiar para `.env`. POLICY não é preciso — o motor é sigma.
# bun run contas  → lista PRIVATE_KEY_1/2 sem imprimir a chave.

# Um par = saldo inteiro. Vários no mesmo processo = saldo / n.
HL_COINS=BTC
# HL_COINS=BTC,SOL

HL_TESTNET=false
DRY_RUN=true
LEVERAGE=1
BANKROLL_USD=200
LEDGER_DIR=./data/ledger
REGIME_DIR=./data/regime
TICK_MS=2000
BOOK_STALE_MS=5000
PORT=3000

# Conta 1 (default). PRIVATE_KEY antigo ainda vale e vence a _1.
PRIVATE_KEY_1=
PRIVATE_KEY_2=
# Segundo processo, outra carteira:
# ACCOUNT=2
# PORT=3001

# --- Laboratório. Nada daqui é preciso para arrancar o sigma. ---
# MODEL=mock
# POLICY=jev
# POLICY_FILE=./policy/jev_questions.json
# JEV_PROVIDER=typesafe
# TYPESAFE_API_KEY=
# JEV_MODEL_ID=
# AI_GATEWAY_API_KEY=
# JEV_TIMEOUT_MS=800
# JEV_CONF_ACT=0.80
# NOUL_HOSTILE_TH=0.65
# STATE_MAX_WORDS=12
# OUTCOME_HORIZON_SECS=900
# PRICE_MS=200
# QUOTE_USD=40
# QUOTE_INSIDE_TICKS=1
# CLOSE_SLIPPAGE_BPS=5
# HORIZON_BLOCKS=100
# WALLETS_JSON={"sleeves":[{"coin":"ETH","privateKey":"0x..."}]}
